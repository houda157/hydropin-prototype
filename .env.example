# HydroPin laptop settings. Copy to .env (same folder) and fill in; .env is gitignored.
# Never commit .env: it holds the Telegram bot token. Values set in the shell win over this file.

# --- Telegram alerts (LEAK, new sensor fault, resolved) --------------------------------
# 1. In Telegram, talk to @BotFather -> /newbot -> copy the token it gives you.
# 2. Send any message to your new bot, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id": ...}.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 1 = send Telegram messages (needs the two values above), 0 = off
HYDROPIN_NOTIFY=0

# --- MQTT (the ESP32 publishes to the broker on this laptop) ---------------------------
# 1 = the backend subscribes to the broker; 0 = REST only (simulator with --post)
HYDROPIN_MQTT=0
HYDROPIN_MQTT_HOST=localhost
HYDROPIN_MQTT_PORT=1883

# --- Storage ---------------------------------------------------------------------------
# SQLite database for readings, runs, events and detector frames
HYDROPIN_DB=data/hydropin.db
